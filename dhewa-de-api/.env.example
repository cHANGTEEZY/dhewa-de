PORT=3001
NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0

CORS_ORIGIN=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hono_api
# DATABASE_URL_UNPOOLED=  # optional for Neon migrations

# Browser origin. The Vite dev server proxies /api to this process.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

# Optional. Set both values or leave both empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Get your key from https://app.arcjet.com or run: npx @arcjet/cli auth login
ARCJET_KEY=ajkey_your_key_here
ARCJET_ENV=development
